# ---- MLflow tracking -------------------------------------------------------
# Default: local SQLite backend + local artifact store (no server needed).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlartifacts

# Optional: run a real MLflow server instead (docker compose up mlflow)
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# ---- DagsHub ---------------------------------------------------------------
# Fill these in to stream every run to DagsHub-hosted MLflow.
# Training picks them up automatically when MEDMLOPS_TRACKER=dagshub
# (or when the CLI is called with --dagshub).
DAGSHUB_USER_NAME=
DAGSHUB_REPO_NAME=
DAGSHUB_USER_TOKEN=
MEDMLOPS_TRACKER=local

# ---- API -------------------------------------------------------------------
MEDMLOPS_API_HOST=127.0.0.1
MEDMLOPS_API_PORT=8000
MEDMLOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDMLOPS_MODEL_DIR=./artifacts/models
MEDMLOPS_DB_PATH=./artifacts/monitoring.db
# Optional MLflow model URIs (leave empty to use local checkpoints)
MEDMLOPS_SEG_MODEL_URI=
MEDMLOPS_CLF_MODEL_URI=
