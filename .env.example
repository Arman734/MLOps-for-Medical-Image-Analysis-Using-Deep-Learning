# Copy to .env and edit. Real environment variables always win over this file.
# ---------------------------------------------------------------------------
# MLflow tracking (local default: SQLite + local artifact store, no server)
# ---------------------------------------------------------------------------
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_ARTIFACT_ROOT=./mlartifacts

# Use a running MLflow server instead (compose default, or `make mlflow`):
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# ---------------------------------------------------------------------------
# DagsHub (one switch): fill the three credentials, set MEDMLOPS_TRACKER=dagshub
# or pass --dagshub to `medmlops train`. Runs, artifacts and the registry then
# live on DagsHub-hosted MLflow.
# ---------------------------------------------------------------------------
DAGSHUB_USER_NAME=
DAGSHUB_REPO_NAME=
DAGSHUB_USER_TOKEN=
MEDMLOPS_TRACKER=local

# ---------------------------------------------------------------------------
# API / console
# ---------------------------------------------------------------------------
MEDMLOPS_API_HOST=127.0.0.1
MEDMLOPS_API_PORT=8000
MEDMLOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEDMLOPS_MODEL_DIR=./artifacts/models
MEDMLOPS_DB_PATH=./artifacts/monitoring.db
MEDMLOPS_MAX_UPLOAD_MB=15
MEDMLOPS_DEVICE=auto

# Optional shared secret. When set, every /api route except health/ready
# requires `X-API-Key: <value>` (the console prompts for it on first 401).
MEDMLOPS_API_KEY=

# Pull champion checkpoints from MLflow on startup when the model dir is empty.
# Requires MLFLOW_TRACKING_URI (and DAGSHUB_* when tracking there).
MEDMLOPS_BOOTSTRAP_FROM_REGISTRY=0
MEDMLOPS_REGISTRY_NAMES=isic-lesion-unet,pneumonia-densenet

# Optional MLflow model URIs (leave empty to use local checkpoints)
MEDMLOPS_SEG_MODEL_URI=
MEDMLOPS_CLF_MODEL_URI=

# ---------------------------------------------------------------------------
# Docker Compose only
# ---------------------------------------------------------------------------
# In-cluster MLflow URL used by the api service (default http://mlflow:5000).
# Do not reuse MLFLOW_TRACKING_URI here: that one points at a local SQLite file.
MEDMLOPS_TRACKING_URI=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=medmlops
